# SandMLE environment configuration — copy to `.env`, fill in, and `source .env`.
# None of these values are committed. See examples/deepresearch/README.md for details.

# --- Repo root (used only for relative defaults) ---
export SANDMLE_ROOT="$(pwd)"

# --- Datasets ---
# Real MLE-bench data (download with `mlebench`; see examples/deepresearch/DATA.md).
export SANDMLE_DATA_ROOT="${SANDMLE_ROOT}/data/mle-bench-data"
# Synthetic SandMLE tasks (download from Google Drive; see examples/deepresearch/DATA.md).
export SANDMLE_SYN_DATA_ROOT="${SANDMLE_ROOT}/data/mle-bench-syn"
# Registered train/val parquet datasets (produced by prepare_train_data.py).
export SANDMLE_DATASETS_DIR="${SANDMLE_ROOT}/data/datasets"
export SANDMLE_SFT_OUT_DIR="${SANDMLE_DATASETS_DIR}/mle_bench_sft"
# Sanity-passed synthetic task id lists (shipped inside the synthetic task bundle).
export SANDMLE_OK_LIST="${SANDMLE_SYN_DATA_ROOT}/ok_competitions_sanity.json"
export SANDMLE_OK_LIST_SAMPLED="${SANDMLE_SYN_DATA_ROOT}/ok_competitions_sanity_random_64.json"

# --- Models / checkpoints ---
# Directory containing base model weights (default resolves to the HF id `Qwen/Qwen3-8B`).
export SANDMLE_MODEL_DIR="Qwen"
# Where training writes checkpoints.
export SANDMLE_CKPT_DIR="${SANDMLE_ROOT}/checkpoints"

# --- Execution sandbox (SRUN API) ---
# Conda env in which the SRUN API runs the agent's generated code steps.
export SANDMLE_CONDA_ENV="sandmle"
# URL where srun_api.py is served (start it first; see scripts/serve_srun_api.sh).
export SRUN_API_URL="http://127.0.0.1:9000"
export SRUN_API_MAX_CONCURRENT="128"

# --- Policy serving (evaluation) ---
# vLLM OpenAI-compatible endpoint serving the base/finetuned policy.
export SANDMLE_MODEL_BASE_URL="http://127.0.0.1:8001/v1"
export SANDMLE_SERVED_MODEL_NAME="sandmle_policy"
export SANDMLE_MODEL_API_KEY="None"

# --- Reward mode for the ablation: "dense" (default) or "sparse" ---
export SANDMLE_REWARD="dense"

# --- Experiment tracking ---
export WANDB_PROJECT="sandmle"

# --- Secrets (only if using hosted reference models / web tools) ---
# export OPENROUTER_API_KEY="..."
# export SERPER_API_KEY="..."
